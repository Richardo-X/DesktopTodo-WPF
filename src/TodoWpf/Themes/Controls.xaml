<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      控件样式（v3.4 + L1 定稿）：全部颜色走令牌（DynamicResource 便于日夜切换），
      尺寸走令牌（StaticResource，运行期不变）。已知 WPF 差异（批次 03 处理）：
      悬停变色瞬时切换（CSS 的 180ms 颜色过渡需逐状态画刷克隆）；按压反馈已按
      KeySpline 缓动真动画（scale .96，120ms）。
    -->

    <!-- 按压反馈动画片段：scale 0.96（L1 第 4 项，统一缓出曲线）。
         x:Shared=False：多控件并发触发各自克隆实例；TargetName=bd 对齐各模板边框名。
         时长经 Duration.Press 令牌：减少动画关怀下该令牌归零（动画即被关闭）。 -->
    <Storyboard x:Key="Anim.PressIn" x:Shared="False">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       Duration="{StaticResource Duration.Press}">
            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="{StaticResource Double.PressScale}"
                                  KeySpline="{StaticResource KeySpline.EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       Duration="{StaticResource Duration.Press}">
            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="{StaticResource Double.PressScale}"
                                  KeySpline="{StaticResource KeySpline.EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>
    <Storyboard x:Key="Anim.PressOut" x:Shared="False">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       Duration="{StaticResource Duration.Press}">
            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1"
                                  KeySpline="{StaticResource KeySpline.EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="bd"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                       Duration="{StaticResource Duration.Press}">
            <SplineDoubleKeyFrame KeyTime="0:0:0.12" Value="1"
                                  KeySpline="{StaticResource KeySpline.EaseOut}"/>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- 图标按钮 32×32（主窗 ⚡/☑、已完成排序等）：Tag=Geometry，图标 16px、线宽 1.8。
         底纹口径以**成品 v1.1.1** 为准（浅底 + 1px 描边；开态=主题色描边+图标）——
         原型此处为透明无边，属旧仓 HANDOFF §11.E 记录的"原型↔成品既存漂移"第 1 项 -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Size.IconButton}"/>
        <Setter Property="Height" Value="{StaticResource Size.IconButton}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Btn}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BtnBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Path Data="{TemplateBinding Tag}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                              Width="{StaticResource Size.IconLarge}"
                              Height="{StaticResource Size.IconLarge}"
                              Stretch="Uniform" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.BtnHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Active}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ＋新建按钮 32×32 主色块（白图标） -->
    <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Path Data="{TemplateBinding Tag}"
                              Stroke="{DynamicResource Brush.AccentFg}"
                              Width="{StaticResource Size.IconLarge}"
                              Height="{StaticResource Size.IconLarge}"
                              Stretch="Uniform" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小按钮 26px（批量删除等）：Tag=Geometry 可选图标 13px（线宽 1.7）+ 文字 11.5px -->
    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Size.SmallButton}"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Btn}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BtnBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.SmallFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="icon" Data="{TemplateBinding Tag}" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  Width="{StaticResource Size.IconMedium}"
                                  Height="{StaticResource Size.IconMedium}"
                                  Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="body" VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="body" Property="Margin" Value="0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.BtnHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮 30px（确认框/提交） -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Size.Button}"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentFg}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.BodyFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险按钮 30px（确认框红删除；悬停深红已令牌化 Brush.DangerHover） -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 块按钮 30px（全宽中性底；原型 .btn.block：已完成窗「历史记录」） -->
    <Style x:Key="BlockButton" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource Size.Button}"/>
        <Setter Property="Padding" Value="13,0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Btn}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BtnBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.BodyFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path x:Name="icon" Data="{TemplateBinding Tag}" Fill="Transparent"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                  Width="{StaticResource Size.IconMedium}"
                                  Height="{StaticResource Size.IconMedium}"
                                  Stretch="Uniform" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.BtnHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险幽灵按钮 26px（二级窗「删除」） -->
    <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>

    <!-- 步进器 28×28（设置页 − / ＋；字形按定稿保留） -->
    <Style x:Key="StepperButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Size.Stepper}"/>
        <Setter Property="Height" Value="{StaticResource Size.Stepper}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Btn}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BtnBorder}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}"/>
        <Setter Property="FontSize" Value="{StaticResource Size.BodyFont}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.BtnHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 勾选框 20×20（完成/批量同款）：勾 = I.check 线宽 3（L1.5 定稿） -->
    <Style x:Key="Checkbox" TargetType="CheckBox">
        <Setter Property="Width" Value="{StaticResource Size.Checkbox}"/>
        <Setter Property="Height" Value="{StaticResource Size.Checkbox}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Brush.CbBorder}" BorderThickness="1.5"/>
                        <Path x:Name="check" Data="{StaticResource Icon.Check}"
                              Stroke="{DynamicResource Brush.AccentFg}"
                              Width="{StaticResource Size.IconCheck}"
                              Height="{StaticResource Size.IconCheck}"
                              Stretch="Uniform" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ＋框 20×20（模板行一键添加）：图标 11px、线宽 2 -->
    <Style x:Key="PlusBox" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Size.Checkbox}"/>
        <Setter Property="Height" Value="{StaticResource Size.Checkbox}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="{StaticResource Radius.Control}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush.CbBorder}" BorderThickness="1.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Path Data="{StaticResource Icon.Plus}"
                              Stroke="{DynamicResource Brush.Muted}"
                              Width="{StaticResource Size.IconSmall}"
                              Height="{StaticResource Size.IconSmall}"
                              Stretch="Uniform" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏按钮 42×36（Tag=Geometry，图标 13px、线宽 1.7） -->
    <Style x:Key="TitlebarButton" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource Size.TitlebarButtonWidth}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <Path Data="{TemplateBinding Tag}" Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                              Width="{StaticResource Size.IconMedium}"
                              Height="{StaticResource Size.IconMedium}"
                              Stretch="Uniform" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标题栏关闭（悬停红底白图标，同原型 .wbtn.close） -->
    <Style x:Key="TitlebarCloseButton" TargetType="Button" BasedOn="{StaticResource TitlebarButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent">
                        <Path Data="{TemplateBinding Tag}" Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                              Width="{StaticResource Size.IconMedium}"
                              Height="{StaticResource Size.IconMedium}"
                              Stretch="Uniform" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentFg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.DangerHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 待办行（悬停底色；行内边距 11/12；圆角 8） -->
    <Style x:Key="TodoRow" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Row}"/>
        <Setter Property="Padding" Value="11,12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
