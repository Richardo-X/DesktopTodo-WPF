<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设计令牌 · 夜间主题（逐值对齐原型 v3.4 [data-theme="night"]；danger/overdue 继承日间） -->

    <Color x:Key="Color.Accent">#4CC2FF</Color>
    <Color x:Key="Color.AccentHover">#6FCDFF</Color>
    <Color x:Key="Color.AccentFg">#06131C</Color>
    <Color x:Key="Color.WinBgBase">#1E1E21</Color>
    <Color x:Key="Color.Text">#F2F3F5</Color>
    <Color x:Key="Color.Muted">#ABAFB8</Color>
    <Color x:Key="Color.Faint">#7D818C</Color>
    <Color x:Key="Color.Danger">#C42B1C</Color>
    <Color x:Key="Color.Overdue">#D13438</Color>
    <Color x:Key="Color.CardSolid">#2C2C2E</Color>
    <Color x:Key="Color.BubbleBg">#3A3A3C</Color>
    <Color x:Key="Color.BubbleFg">#F0F0F0</Color>
    <Color x:Key="Color.CbBorder">#9A9A9A</Color>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentFg" Color="{StaticResource Color.AccentFg}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.Faint" Color="{StaticResource Color.Faint}"/>
    <SolidColorBrush x:Key="Brush.Overdue" Color="{StaticResource Color.Overdue}"/>
    <SolidColorBrush x:Key="Brush.CbBorder" Color="{StaticResource Color.CbBorder}"/>
    <SolidColorBrush x:Key="Brush.CardSolid" Color="{StaticResource Color.CardSolid}"/>

    <!-- 半透明卡面（α：win .96→F5 / card .055→0E / border .11→1C / field .07→12 /
         hover .06→0F / active .12→1F / btn .08→14 / btn-border .15→26 / btn-hover .16→29） -->
    <!-- 真磨砂（C2）：卡面 α 由 96% 降至 75%，配合 DWM blur 让壁纸隐约透出 -->
    <SolidColorBrush x:Key="Brush.WinBg" Color="#BF1E1E21"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#0EFFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Field" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Active" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Btn" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Brush.BtnBorder" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Brush.BtnHover" Color="#29FFFFFF"/>

    <!-- 蒙层与模态置灰（日夜同值，继承日间定义） -->
    <SolidColorBrush x:Key="Brush.Mask" Color="#750A1428"/>
    <SolidColorBrush x:Key="Brush.BlockedVeil" Color="#33141419"/>

    <!-- 缩进白条（日夜同值，继承日间定义） -->
    <SolidColorBrush x:Key="Brush.TuckBar" Color="#47FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TuckBarHover" Color="#80FFFFFF"/>

</ResourceDictionary>
