<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 设计令牌 · 白天主题（逐值对齐原型 v3.4 :root；#AARRGGBB，α 由 CSS rgba 换算） -->

    <Color x:Key="Color.Accent">#4F7391</Color>
    <Color x:Key="Color.AccentHover">#5F86A5</Color>
    <Color x:Key="Color.AccentFg">#F7FAFC</Color>
    <Color x:Key="Color.WinBgBase">#F3F6FB</Color>
    <Color x:Key="Color.Text">#33383F</Color>
    <Color x:Key="Color.Muted">#5C636C</Color>
    <Color x:Key="Color.Faint">#676D76</Color>
    <Color x:Key="Color.Danger">#C42B1C</Color>
    <Color x:Key="Color.Overdue">#A83A34</Color>
    <Color x:Key="Color.CardSolid">#F9FAFC</Color>
    <Color x:Key="Color.BubbleBg">#FFFFFF</Color>
    <Color x:Key="Color.BubbleFg">#222222</Color>
    <Color x:Key="Color.CbBorder">#8A8A8A</Color>

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/>
    <SolidColorBrush x:Key="Brush.AccentFg" Color="{StaticResource Color.AccentFg}"/>
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
    <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}"/>
    <SolidColorBrush x:Key="Brush.Faint" Color="{StaticResource Color.Faint}"/>
    <SolidColorBrush x:Key="Brush.Overdue" Color="{StaticResource Color.Overdue}"/>
    <SolidColorBrush x:Key="Brush.CbBorder" Color="{StaticResource Color.CbBorder}"/>
    <SolidColorBrush x:Key="Brush.CardSolid" Color="{StaticResource Color.CardSolid}"/>

    <!-- 半透明卡面（α：win .94→F0 / card .7→B3 / border .09→17 / field .9→E6 /
         hover .05→0D / active .09→17 / btn .75→BF / btn-border .13→21 / btn-hover→FF） -->
    <!-- 卡面底：逐值取自基准（#f3f6fb α.94 → #F0F3F6FB）；真磨砂专项已撤，恢复基准透明度 -->
    <SolidColorBrush x:Key="Brush.WinBg" Color="#F0F3F6FB"/>
    <!-- 不透明卡面底：拖拽缩放期间临时替换（抑制透明窗逐帧合成的拖影） -->
    <SolidColorBrush x:Key="Brush.WinBgSolid" Color="#F3F6FB"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#17000000"/>
    <SolidColorBrush x:Key="Brush.Field" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Hover" Color="#0D000000"/>
    <SolidColorBrush x:Key="Brush.Active" Color="#17000000"/>
    <SolidColorBrush x:Key="Brush.Btn" Color="#BFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.BtnBorder" Color="#21000000"/>
    <SolidColorBrush x:Key="Brush.BtnHover" Color="#FFFFFF"/>

    <!-- 蒙层与模态置灰（L1：色调化 rgba(10,20,40,.46) / rgba(20,20,25,.20)） -->
    <SolidColorBrush x:Key="Brush.Mask" Color="#750A1428"/>
    <SolidColorBrush x:Key="Brush.BlockedVeil" Color="#33141419"/>

    <!-- 缩进白条（原型 #tuckBar：白 α.28，悬停亮 α.5，日夜同值） -->
    <SolidColorBrush x:Key="Brush.TuckBar" Color="#47FFFFFF"/>
    <SolidColorBrush x:Key="Brush.TuckBarHover" Color="#80FFFFFF"/>

    <!-- 新外观（1C）表面令牌：新窗口引用；旧外观窗口删除后清理旧键 -->
    <SolidColorBrush x:Key="Brush.Shell" Color="#FFEEF1F6"/>
    <SolidColorBrush x:Key="Brush.RowCard" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.RowCardBorder" Color="#0F1E232A"/>
    <SolidColorBrush x:Key="Brush.RowCardHover" Color="#FFF5F7F9"/>
    <SolidColorBrush x:Key="Brush.FieldSurface" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.FieldSurfaceBorder" Color="#1A1E232A"/>
    <SolidColorBrush x:Key="Brush.SoftAccent" Color="#244F7391"/>
    <SolidColorBrush x:Key="Brush.SoftOverdue" Color="#1AA83A34"/>
    <SolidColorBrush x:Key="Brush.OverdueEdge" Color="#59A83A34"/>
    <SolidColorBrush x:Key="Brush.CounterChip" Color="#0F1E232A"/>
    <SolidColorBrush x:Key="Brush.Hairline" Color="#1F1E232A"/>
    <SolidColorBrush x:Key="Brush.DoneStamp" Color="#FF5C636C"/>

</ResourceDictionary>
