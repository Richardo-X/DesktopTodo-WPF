<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:win="clr-namespace:TodoWpf.Windows">

    <!--
      设计令牌 · 尺寸/圆角/时长/缓动（主题无关，一次定义）
      基准：docs/参考/交互原型-v3.4-taste.html + docs/参考/v1.1.1-L1-体验说明书.md
      技能口径（design-taste-frontend）：产品 UI 不在其 landing 射程内，本套是
      "preserve 重设计"的桌面工具令牌系统；无官方 WPF Fluent 包，故为原生
      ResourceDictionary（诚实口径，非重建某个官方包）。
    -->

    <!-- 圆角阶梯：6 控件 / 8 行 / 10 对话框与面板 / 4 手柄悬停 -->
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Row">8</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">10</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">10</CornerRadius>
    <CornerRadius x:Key="Radius.Grip">4</CornerRadius>

    <!-- 按钮规格阶梯（v1.1.1 定稿）：图标 32 / 主 30 / 小 26 / 步进器 28 / 勾选框与＋框 20 -->
    <sys:Double x:Key="Size.IconButton" xmlns:sys="clr-namespace:System;assembly=mscorlib">32</sys:Double>
    <sys:Double x:Key="Size.Button" xmlns:sys="clr-namespace:System;assembly=mscorlib">30</sys:Double>
    <sys:Double x:Key="Size.SmallButton" xmlns:sys="clr-namespace:System;assembly=mscorlib">26</sys:Double>
    <sys:Double x:Key="Size.Stepper" xmlns:sys="clr-namespace:System;assembly=mscorlib">28</sys:Double>
    <sys:Double x:Key="Size.Checkbox" xmlns:sys="clr-namespace:System;assembly=mscorlib">20</sys:Double>
    <sys:Double x:Key="Size.TitlebarButtonWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">42</sys:Double>
    <sys:Double x:Key="Size.TitlebarHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">36</sys:Double>
    <!-- RowDefinition.Height 需要 GridLength（Double 不能用于该属性） -->
    <GridLength x:Key="GridLength.Titlebar">36</GridLength>
    <sys:Double x:Key="Size.BackButtonWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">34</sys:Double>

    <!-- 图标尺寸阶梯：按容器分配 16 / 13 / 11 / 12 -->
    <sys:Double x:Key="Size.IconLarge" xmlns:sys="clr-namespace:System;assembly=mscorlib">16</sys:Double>
    <sys:Double x:Key="Size.IconMedium" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="Size.IconSmall" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="Size.IconCheck" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

    <!-- 窗口基准（v3.4 布局口径） -->
    <sys:Double x:Key="Size.MainWindowWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">360</sys:Double>
    <sys:Double x:Key="Size.MainWindowHeight" xmlns:sys="clr-namespace:System;assembly=mscorlib">640</sys:Double>
    <sys:Double x:Key="Size.SideWindowWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">310</sys:Double>
    <sys:Double x:Key="Size.ClusterGap" xmlns:sys="clr-namespace:System;assembly=mscorlib">4</sys:Double>

    <!-- 时钟（30px Display 半粗 + 12px 日期；等宽数字在用例处以 Typography 设置） -->
    <sys:Double x:Key="Size.ClockTimeFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">38</sys:Double>
    <sys:Double x:Key="Size.ClockDateFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>

    <!-- 字号阶梯：逐值取自基准 交互原型-v3.4-L1（.tt 13.5 / .panel-title 13 / .btn 12.5 /
         .btn.sm 11.5 / .cap-chip 11 / .tag 10 / .step-btn 15 / .clock-time 30 / .clock-date 12） -->
    <sys:Double x:Key="Size.RowFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">13.5</sys:Double>
    <sys:Double x:Key="Size.PanelTitleFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="Size.TagFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>
    <sys:Double x:Key="Size.StepperFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">15</sys:Double>
    <sys:Double x:Key="Size.BodyFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">12.5</sys:Double>
    <sys:Double x:Key="Size.SmallFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>
    <sys:Double x:Key="Size.MicroFont" xmlns:sys="clr-namespace:System;assembly=mscorlib">11</sys:Double>

    <!-- 字体（技能 §4.1：系统字体，禁外链字体 CDN 的 WPF 对应做法） -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC</FontFamily>

    <!-- 动效（L1）：统一缓出 cubic-bezier(.22,.61,.36,1)；时长 120/150/180ms -->
    <KeySpline x:Key="KeySpline.EaseOut" ControlPoint1="0.22,0.61" ControlPoint2="0.36,1"/>
    <Duration x:Key="Duration.Press">0:0:0.12</Duration>
    <Duration x:Key="Duration.Row">0:0:0.15</Duration>
    <Duration x:Key="Duration.Hover">0:0:0.18</Duration>
    <sys:Double x:Key="Double.PressScale" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.96</sys:Double>

    <!-- 确认框（L1 定稿）：宽 420、圆角 10、双层蓝黑投影 rgba(10,20,40,.5/.25) -->
    <sys:Double x:Key="Size.DialogWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">420</sys:Double>
    <Color x:Key="Color.ShadowTint">#0A1428</Color>
    <Color x:Key="Color.ShadowBlack">#000000</Color>
    <sys:Double x:Key="Double.DialogShadowOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.5</sys:Double>
    <sys:Double x:Key="Double.DialogShadowOpacitySoft" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.25</sys:Double>
    <DropShadowEffect x:Key="Effect.DialogShadowMain"
                      Color="{StaticResource Color.ShadowTint}"
                      Opacity="{StaticResource Double.DialogShadowOpacity}"
                      BlurRadius="28" ShadowDepth="12" Direction="270"/>
    <DropShadowEffect x:Key="Effect.DialogShadowSoft"
                      Color="{StaticResource Color.ShadowTint}"
                      Opacity="{StaticResource Double.DialogShadowOpacitySoft}"
                      BlurRadius="8" ShadowDepth="2" Direction="270"/>
    <!-- 纯黑单层对照（规格陈列对比用：展示为何 L1 弃纯黑改蓝黑） -->
    <DropShadowEffect x:Key="Effect.DialogShadowBlack"
                      Color="{StaticResource Color.ShadowBlack}"
                      Opacity="{StaticResource Double.DialogShadowOpacity}"
                      BlurRadius="28" ShadowDepth="12" Direction="270"/>

    <!-- 危险系（日夜同值，继承原型）：按钮 / 危险幽灵描边 / 悬停深红 -->
    <SolidColorBrush x:Key="Brush.Danger" Color="#C42B1C"/>
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#A9271C"/>
    <SolidColorBrush x:Key="Brush.DangerBorder" Color="#8CC42B1C"/>

    <!-- 玻璃窗沿（原型 .win 边框，日夜同值） -->
    <SolidColorBrush x:Key="Brush.GlassEdge" Color="#2EFFFFFF"/>

    <!-- 键盘焦点描边（L1 第 8 项：仅键盘焦点；样式引用 Accent 画刷） -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" StrokeThickness="2"
                               Stroke="{DynamicResource Brush.Accent}"
                               RadiusX="7" RadiusY="7"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 覆盖式 ScrollViewer 模板（2026-11-04 实测修正）：
         WPF 默认模板下 ScrollViewer.Padding 会把**滚动条一起往里推**（实测滚动条右缘 = 右内边距），
         于是"调右内边距让内容两侧等距"必然同时把滚动条推离窗口右缘。
         本模板把滚动条改为**覆盖层**（同一格、右对齐）：既不受 Padding 影响、也不占内容宽度，
         内容两侧由 Padding 独立决定（14/14 等距），滚动条贴窗口右缘。
         名字必须为 PART_ScrollContentPresenter / PART_VerticalScrollBar（ScrollViewer 按名接线）。 -->
    <win:ThicknessBottomMarginConverter x:Key="ThicknessBottomOnly"/>
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        <!-- 下端收到 Padding.Bottom：滚动条下限=内容下截断位置，
                             滑块拖到底也不会越过内容区、不压右下缩放角标（用户 2026-11-05） -->
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                   Width="8" MinWidth="0"
                                   Margin="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ThicknessBottomOnly}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 全应用滚动条：5px 命中区、4px 视觉细条居中、无箭头、透明轨道（用户 2026-11-04 规格）；
         不溢出（Maximum=0）时整条透明，不显示任何滑块。
         「不挤压内容」由调用方保证：滚动容器一律 VerticalScrollBarVisibility=Visible
         （槽位常驻）+ 右内边距同步让出（命中 5px 时右内边距 9 = 两侧 14/14 等距）。 -->
    <Style TargetType="ScrollBar">
        <!-- 命中区 8 DIP（用户 2026-11-04：4px 视觉条在 5px 命中区里每侧仅 0.5 DIP，
             125% 下 = 0.625 物理像素落不到整数 → 渲染吸附到一侧、看着不居中）。
             8 DIP 命中区 + 4 DIP 视觉条 → 每侧 2 DIP，100% 下精确居中；125% 下误差 ≤0.5px。 -->
        <Setter Property="Width" Value="8"/>
        <!-- 必须清 MinWidth：WPF 主题默认 ScrollBar 样式带 MinWidth=系统滚动条宽(17)，
             而 MinWidth 优先于 Width —— 这就是"写 8 却渲染 16"的根因（改 30 能生效是因为 30>17）。 -->
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <!-- 视觉条在命中区内**居中**（用户 2026-11-04 定稿）：
                                                     命中区 8 DIP、视觉条 4 DIP → 两侧各留 2 DIP。
                                                     代价：条右缘距窗口右边 2 DIP（不再贴边）；若日后想「既居中又贴边」，
                                                     把命中区改为 4 DIP（与条同宽）即可。 -->
                                                <Border Width="4" HorizontalAlignment="Center"
                                                        SnapsToDevicePixels="True"
                                                        Background="{DynamicResource Brush.CardBorder}"
                                                        CornerRadius="2"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Maximum" Value="0">
                <Setter Property="Opacity" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
