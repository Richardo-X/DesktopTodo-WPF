<Window x:Class="TodoWpf.Windows.TextEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面待办"
        Width="420" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <!-- 二级窗统一 3:4（420×560，需求 §2.10）：标题栏(返回/标题) → 内容区 → 底部操作。
         用于：新建待办 / 编辑待办 / 模板编辑（兼新建）。 -->
    <Border x:Name="CardRoot" Background="{DynamicResource Brush.WinBg}"
            BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <Grid Margin="18,12,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏：返回（左） + 标题 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Button x:Name="BackBtn" Style="{StaticResource BackButton}" Tag="{StaticResource Icon.ChevL}"
                        ToolTip="返回" Click="Back_Click" HorizontalAlignment="Left"/>
                <TextBlock x:Name="TitleText" Text="新建待办" FontSize="{StaticResource Size.PanelTitleFont}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- 编辑态区（仅编辑模式显示）：状态 + 创建时间 -->
            <StackPanel Grid.Row="1" x:Name="StatePanel" Visibility="Collapsed" Margin="0,4,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StateBadge" Text="进行中" FontSize="{StaticResource Size.TagFont}"
                               Foreground="{DynamicResource Brush.Muted}"/>
                    <TextBlock x:Name="CreatedAtText" FontSize="{StaticResource Size.MicroFont}"
                               Foreground="{DynamicResource Brush.Muted}" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 输入区 -->
            <TextBox Grid.Row="2" x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                     FontSize="{StaticResource Size.RowFont}" Foreground="{DynamicResource Brush.Text}"
                     Background="Transparent" BorderThickness="0"
                     VerticalContentAlignment="Top" Padding="0,8,0,0"
                     TextChanged="Input_Changed"/>

            <!-- 字数计数（将满变红） -->
            <TextBlock Grid.Row="3" x:Name="CounterText" Text="0/300" HorizontalAlignment="Right"
                       FontSize="{StaticResource Size.MicroFont}"
                       Foreground="{DynamicResource Brush.Muted}" Margin="0,6,0,0"/>

            <!-- 底部操作（按钮组由打开方注入） -->
            <StackPanel Grid.Row="4" x:Name="ActionsPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,14,0,0"/>
        </Grid>
    </Border>
</Window>
