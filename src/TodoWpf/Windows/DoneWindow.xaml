<Window x:Class="TodoWpf.Windows.DoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="已完成"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <!-- 已完成（当天）壳：假数据；业务批次 04 接线 -->

    <Border x:Name="CardRoot" Background="{DynamicResource Brush.WinBg}"
            BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Panel}">

        <!-- 内容按设计尺寸（310×640）绘制一次，缩放走 LayoutTransform：布局尺寸＝设计尺寸×scale，
             窗口就是按这个尺寸摆的，两者一致。本窗钉住左上角（左缘随主窗右缘走，由窗口矩形承担平移）。 -->
        <Grid x:Name="CardContent" Width="310" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource GridLength.Titlebar}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_MouseDown">
            <TextBlock Text="已完成" FontSize="{StaticResource Size.PanelTitleFont}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock x:Name="DoneCount" Text="已完成 · 3" FontSize="{StaticResource Size.PanelTitleFont}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                           VerticalAlignment="Center"/>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource Icon.SortAsc}"
                        ToolTip="排序（批次 04 实装）" HorizontalAlignment="Right"/>
            </Grid>

            <!-- 真实已完成列表（绑定 DoneRows，按 DoneSort 排序） -->
            <Grid Grid.Row="1">
                <ItemsControl x:Name="DoneList" ItemsSource="{Binding DoneRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource TodoRow}" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Checkbox}" IsChecked="True"
                                              Unchecked="RowReturn_Unchecked" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Content}"
                                               FontSize="{StaticResource Size.RowFont}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,10,0"/>
                                    <TextBlock Grid.Column="2" Text="逾期"
                                               FontSize="{StaticResource Size.TagFont}"
                                               Foreground="{DynamicResource Brush.Overdue}"
                                               VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Overdue}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding CompletedTimeText}"
                                               FontSize="{StaticResource Size.MicroFont}"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               VerticalAlignment="Center" MinWidth="34"
                                               TextAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="DoneEmpty" Text="今天还没有完成的事项"
                           FontSize="{StaticResource Size.MicroFont}"
                           Foreground="{DynamicResource Brush.Faint}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
            </Grid>

            <Button Grid.Row="2" Style="{StaticResource BlockButton}" Tag="{StaticResource Icon.Clock}"
                    Content="历史记录"
                    ToolTip="历史记录（批次 04 实装）"/>
        </Grid>
        </Grid>
    </Border>

</Window>
