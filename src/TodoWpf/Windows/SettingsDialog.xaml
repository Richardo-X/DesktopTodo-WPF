<Window x:Class="TodoWpf.Windows.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面待办"
        Width="420" Height="560"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource Brush.Shell}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <!-- 设置窗（原型 openSettings + 体验说明书 ③.3）：上限步进 / 时制 / 主题 / 历史入口 /
         导入历史（覆盖·合并）/ 恢复默认尺寸 / 开机自启；所有设置即时生效并落盘。 -->
    <Window.Resources>
        <!-- seg 分段按钮（原型 .seg）：26 高、相邻 1px 分隔、on=淡底+accent 字 -->
        <Style x:Key="SegBtn" TargetType="RadioButton">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="0,0,1,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SoftAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 步进按钮（原型 .stepper .step：26×26） -->
        <Style x:Key="StepBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小按钮（原型 .btn.sm：28 高） -->
        <Style x:Key="SmBtn" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.CardSolid}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 开关（原型 .switch：36×20 胶囊 + 14 knob） -->
        <Style x:Key="SwitchBtn" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="track" CornerRadius="99"
                                    Background="{DynamicResource Brush.CounterChip}"
                                    BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="17" Height="17" Fill="{DynamicResource Brush.Muted}"
                                     HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.SoftAccent}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{DynamicResource Brush.Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="21" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush.CardBorder}"/>
        </Style>
    </Window.Resources>

    <Border x:Name="CardRoot" Background="{DynamicResource Brush.Shell}"
            BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Button x:Name="BackBtn" Style="{StaticResource BackButton}" Tag="{StaticResource Icon.ChevL}"
                        ToolTip="返回" Click="Back_Click" HorizontalAlignment="Left"/>
                <TextBlock Text="设置" FontSize="15.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- 内容（可滚动；分组项锁死不被压缩） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible"
                          HorizontalScrollBarVisibility="Disabled" Padding="20,4,17,16">
                <StackPanel>
                    <!-- 待办数量上限 -->
                    <Grid Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="待办数量上限" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="1~10 条；不可低于当前待办数量" FontSize="13"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                                CornerRadius="6" Height="32">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="MinusBtn" Style="{StaticResource StepBtn}" Content="−"
                                        Margin="1,0,0,0" Click="Minus_Click"/>
                                <TextBlock x:Name="MaxValue" Text="10" FontSize="14" Width="28"
                                           TextAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text}"
                                           Typography.NumeralAlignment="Tabular"/>
                                <Button x:Name="PlusBtn" Style="{StaticResource StepBtn}" Content="＋"
                                        Margin="0,0,1,0" Click="Plus_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,10"/>

                    <!-- 时间显示制式 -->
                    <Grid Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="时间显示制式" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="作用于主窗时钟" FontSize="13"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                                CornerRadius="6" Height="28">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Seg24" Content="24 小时制" Style="{StaticResource SegBtn}"
                                             GroupName="hour" Checked="Hour_Checked"/>
                                <RadioButton x:Name="Seg12" Content="12 小时制" Style="{StaticResource SegBtn}"
                                             GroupName="hour" BorderThickness="0" Checked="Hour_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,10"/>

                    <!-- 界面主题 -->
                    <Grid Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="界面主题" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="白天 / 夜间（即时生效）" FontSize="13"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                                CornerRadius="6" Height="28">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="SegDay" Content="白天" Style="{StaticResource SegBtn}"
                                             GroupName="theme" Checked="Theme_Checked"/>
                                <RadioButton x:Name="SegNight" Content="夜间" Style="{StaticResource SegBtn}"
                                             GroupName="theme" BorderThickness="0" Checked="Theme_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,10"/>

                    <!-- 历史记录 -->
                    <Grid Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="历史记录" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="按天查看已归档的完成事项" FontSize="13"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Content="打开" Style="{StaticResource SmBtn}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="History_Click"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,10"/>

                    <!-- 导入历史记录 -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="导入历史记录" FontSize="15.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="只接受本软件导出的 CSV；覆盖导入会替换现有全部历史" FontSize="13"
                                   Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="覆盖导入" Style="{StaticResource SmBtn}" Click="ImportCover_Click"/>
                            <Button Content="合并导入" Style="{StaticResource SmBtn}" Margin="8,0,0,0"
                                    Click="ImportMerge_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource Divider}" Margin="0,10"/>

                    <!-- 恢复默认尺寸（体验说明书 ③.3） -->
                    <Grid Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="恢复默认尺寸" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="按当前屏重算（屏高 1/3）" FontSize="13"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Content="重算" Style="{StaticResource SmBtn}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="ResetSize_Click"/>
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,10"/>

                    <!-- 开机自启 -->
                    <Grid Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="开机自启" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <TextBlock Text="开启后开机直接显示组件窗口" FontSize="13"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="AutoStartSwitch" Style="{StaticResource SwitchBtn}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Click="AutoStart_Click"/>
                    </Grid>

                    <TextBlock Text="桌面待办 · WPF 新外观" FontSize="12"
                               Foreground="{DynamicResource Brush.Faint}" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        
            <!-- 二级窗等比缩放手柄（DialogScale：右下拖动 0.7~1.2，按组存档；无长度缩放） -->
            <Grid x:Name="ScaleGrip" Grid.RowSpan="2" Width="24" Height="24"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Cursor="SizeNWSE" Background="Transparent" Panel.ZIndex="9">
                <Border Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,3,3" Opacity="0.7"
                        BorderBrush="{DynamicResource Brush.Muted}" BorderThickness="0,0,2,2"
                        CornerRadius="0,0,9,0"/>
            </Grid>
</Grid>
    </Border>
</Window>
