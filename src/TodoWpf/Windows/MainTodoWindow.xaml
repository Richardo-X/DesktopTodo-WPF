<Window x:Class="TodoWpf.Windows.MainTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面待办"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <!-- 待办主窗（应用主页）。布局按基准 交互原型-v3.4-L1：
         标题栏 → 操作区两行（上行 ⚡左/☑右＋时钟居中；下行 计数胶囊左、批量删除+＋右）→ 列表。
         业务按钮批次 04 接线。 -->
    <Border x:Name="CardRoot" Background="{DynamicResource Brush.WinBg}"
            BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Panel}">
    <Grid>

        <!-- 内容按设计尺寸（470×640）绘制一次，缩放走 LayoutTransform：布局尺寸＝设计尺寸×scale，
             窗口就是按这个尺寸摆的，两者一致。左上角＝本窗钉住角（缩放锚点＝主窗左上角）。 -->
        <Grid x:Name="CardContent" Width="470" Height="640" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
        <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource GridLength.Titlebar}"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏（拖动区） -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Width="17" Height="17" CornerRadius="{StaticResource Radius.Control}"
                                Background="{DynamicResource Brush.Accent}">
                            <Path Data="{StaticResource Icon.Check}"
                                  Stroke="{DynamicResource Brush.AccentFg}" StrokeThickness="3.4"
                                  Width="10" Height="10" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                        <TextBlock Text="桌面待办" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,14,0">
                        <Button x:Name="ThemeBtn" Style="{StaticResource TitlebarButton}"
                                Tag="{StaticResource Icon.Moon}" ToolTip="切换日/夜主题" Click="ThemeBtn_Click"/>
                        <Button x:Name="PinBtn" Style="{StaticResource TitlebarButton}"
                                Tag="{StaticResource Icon.Pin}" ToolTip="窗口置顶开关" Click="PinBtn_Click"/>
                        <Button x:Name="TuckLockBtn" Style="{StaticResource TitlebarButton}"
                                Tag="{StaticResource Icon.TuckLock}" ToolTip="缩进锁定" Click="TuckLockBtn_Click"/>
                        <Button Style="{StaticResource TitlebarButton}" Tag="{StaticResource Icon.Gear}"
                                ToolTip="设置（批次 04 实装）"/>
                        <Button Style="{StaticResource TitlebarCloseButton}" Tag="{StaticResource Icon.X}"
                                ToolTip="缩小到通知栏" Click="HideBtn_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="14,8,14,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 操作区上排：⚡（左）/ 时钟块（居中）/ ☑（右）。
                         上排沿用 Electron 口径：⚡☑ 上缘对齐"日期上缘"（=时间行高 38×1.1 + 日期上边距 2 = 43.8），
                         所以两枚按钮的下推量与时钟字号绑定，改字号时此处一起看。 -->
                    <!-- ⚡/☑ 的上缘对齐"日期"上缘：Electron 口径 .row-top{align-items:flex-start} +
                         .row-top .icon-btn{ margin-top: calc(38px*1.1 + 2px) } = 43.8
                         （时间行高 41.8 = 38×1.1，日期上边距 2）。 -->
                    <Grid Grid.Row="0" Margin="2,0,2,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                            <TextBlock x:Name="ClockTime" Text="14:32" FontSize="{StaticResource Size.ClockTimeFont}"
                                       FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}"
                                       Foreground="{DynamicResource Brush.Text}"
                                       Typography.NumeralAlignment="Tabular" LineHeight="41.8"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ClockDate" Text="2026年10月12日 星期一"
                                       FontSize="{StaticResource Size.ClockDateFont}"
                                       Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="QuickBtn" Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.BoltOptical}" ToolTip="快捷添加开关"
                                Click="QuickBtn_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,43.8,0,0"/>
                        <Button x:Name="DoneBtn" Style="{StaticResource IconButton}"
                                Tag="{StaticResource Icon.PanelCheck}" ToolTip="已完成开关"
                                Click="DoneBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,43.8,0,0"/>
                    </Grid>

                    <!-- 底排三列：计数（占剩余）｜批量删除（固定）｜＋（固定）。列宽确定，
                         右侧两枚按钮不会被压窄，标签也就不会被裁。 -->
                    <Grid Grid.Row="1" Margin="2,10,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource Brush.Hover}" CornerRadius="99" Padding="10,3"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock x:Name="CountText" Text="3/10" FontSize="{StaticResource Size.MicroFont}"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Border>
                        <Button Grid.Column="1" Style="{StaticResource SmallButton}" Tag="{StaticResource Icon.Trash}"
                                Content="批量删除" ToolTip="批量删除（批次 04 实装）" Margin="0,0,8,0"
                                Width="92" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Style="{StaticResource AddButton}"
                                Tag="{StaticResource Icon.Plus}" ToolTip="新建待办（批次 04 实装）"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 真实待办列表（绑定 MainTodoWindow.Rows）；空态文案 = 原型 .empty -->
                    <Grid Grid.Row="2">
                        <ItemsControl x:Name="TodoList" ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TodoRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource Icon.Grip}"
                                                  Fill="{DynamicResource Brush.Faint}" Width="13" Height="13"
                                                  Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Content}"
                                                       FontSize="{StaticResource Size.RowFont}"
                                                       Foreground="{DynamicResource Brush.Text}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="逾期"
                                                       FontSize="{StaticResource Size.TagFont}"
                                                       Foreground="{DynamicResource Brush.Overdue}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Overdue}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <CheckBox Grid.Column="3" Style="{StaticResource Checkbox}"
                                                      IsChecked="False" IsHitTestVisible="False"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    x:Name="TodoEmpty" Visibility="Hidden">
                            <TextBlock Text="今日做点什么好呢" FontSize="{StaticResource Size.PanelTitleFont}"
                                       Foreground="{DynamicResource Brush.Muted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击右上角 ＋ 新建一条待办" FontSize="{StaticResource Size.MicroFont}"
                                       Foreground="{DynamicResource Brush.Faint}" Margin="0,7,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

        </Grid>

        <!-- 缩放角标：**放在被缩放的 CardContent 之外**，直接钉在窗口右下角。
             若把它留在缩放内容里，内容重排晚一拍时角标会跟着晚，观感就是"角标相对边框跑位"
             （用户 2026-10-13 反馈：缩放过程中角标与边框的相对位置必须不变）。
             它自己的大小仍随档位变化——用渲染层缩放、锚点右下角，位置恒在角上。 -->
        <Grid x:Name="ScaleGrip" Width="24" Height="24"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              RenderTransformOrigin="1,1" Cursor="SizeNWSE" Background="Transparent">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="GripScale" ScaleX="1" ScaleY="1"/>
            </Grid.RenderTransform>
            <Border Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,3,3" Opacity="0.7"
                    BorderBrush="{DynamicResource Brush.Muted}" BorderThickness="0,0,2,2"
                    CornerRadius="0,0,9,0"/>
        </Grid>
    </Grid>
    </Border>

</Window>
