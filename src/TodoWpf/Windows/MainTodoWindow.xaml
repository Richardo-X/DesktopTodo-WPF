<Window x:Class="TodoWpf.Windows.MainTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面待办"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource Brush.Shell}"
        ResizeMode="CanResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <Window.Resources>
        <Style x:Key="Ib" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sq" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="3,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Brush.RowCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.RowCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="RowCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Width="16" Height="16" CornerRadius="4"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                Background="Transparent">
                            <Viewbox x:Name="ck" Width="12" Height="12" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Check}"
                                          Stroke="{DynamicResource Brush.AccentFg}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="ck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CardRoot" Background="{DynamicResource Brush.Shell}">
        <Grid>
            <Grid x:Name="CardContent" Width="360" Height="640"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" Margin="16,12,16,4" MouseLeftButtonDown="Titlebar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="5"
                                Background="{DynamicResource Brush.Accent}">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.AccentFg}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="桌面待办" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="ThemeBtn" Style="{StaticResource Ib}" ToolTip="切换日/夜主题" Click="ThemeBtn_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Moon}" Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="PinBtn" Style="{StaticResource Ib}" ToolTip="窗口置顶开关" Click="PinBtn_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Pin}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="TuckLockBtn" Style="{StaticResource Ib}" ToolTip="缩进锁定" Click="TuckLockBtn_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.TuckLock}" Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button Style="{StaticResource Ib}" ToolTip="设置">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Gear}" Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="HideBtn" Style="{StaticResource Ib}" ToolTip="最小化到系统状态栏" Click="HideBtn_Click">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.X}" Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,14">
                        <TextBlock x:Name="ClockTime" Text="14:32" FontSize="28" FontWeight="Medium"
                                   FontFamily="{StaticResource Font.Display}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ClockDate" Text="2026年10月12日 星期一" FontSize="13"
                                   Foreground="{DynamicResource Brush.Faint}" Margin="0,2,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid x:Name="ActionBar" Grid.Row="1" Margin="16,2,16,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 圆角显式 = 高度 24 的一半：WPF 对超大 CornerRadius 会 X/Y 独立截断成椭圆角，
                                 与浏览器按比例缩放的胶囊不同（原型 border-radius:99px 实际得到半径 12 的圆角） -->
                            <Border Background="{DynamicResource Brush.CounterChip}" CornerRadius="12"
                                    Height="24" Padding="9,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CountText" Text="0/10" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Button Style="{StaticResource Sq}" Margin="8,0,0,0" ToolTip="批量删除待办"
                                    Click="BatchToggle_Click">
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.Muted}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Background="{DynamicResource Brush.Accent}" BorderThickness="0"
                                    Width="28" Height="28" Cursor="Hand" ToolTip="新建待办" Click="AddBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource Brush.AccentFg}"
                                                          StrokeThickness="2.2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="QuickBtn" Style="{StaticResource Sq}" Margin="8,0,0,0"
                                    ToolTip="显示 / 隐藏模板窗" Click="QuickBtn_Click">
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource Icon.Bolt}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="BatchBar" Grid.Row="1" Orientation="Horizontal"
                                Visibility="Hidden" Margin="16,2,16,12" VerticalAlignment="Center">
                        <TextBlock x:Name="BatchCount" Text="已选 0 项" FontSize="11"
                                   Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                        <Button x:Name="BatchExitBtn" Content="返回" Click="BatchExit_Click"
                                Margin="10,0,0,0" Height="28" Padding="10,0"
                                Background="Transparent" BorderBrush="{DynamicResource Brush.CardBorder}"
                                BorderThickness="1" Foreground="{DynamicResource Brush.Muted}" Cursor="Hand"/>
                        <Button x:Name="BatchDeleteBtn" Content="删除所选" Click="BatchDelete_Click"
                                Margin="6,0,0,0" Height="28" Padding="10,0" IsEnabled="False"
                                Background="Transparent" BorderBrush="{DynamicResource Brush.OverdueEdge}"
                                BorderThickness="1" Foreground="{DynamicResource Brush.Overdue}" Cursor="Hand"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="12,0,4,26">
                        <StackPanel>
                            <ItemsControl x:Name="TodoList" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RowCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Width="14" Height="14" Margin="-5,0,0,0" VerticalAlignment="Center">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource Icon.Grip}"
                                                              Fill="{DynamicResource Brush.Faint}"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Grid.Column="1" Text="{Binding Content}"
                                                           FontSize="13" Foreground="{DynamicResource Brush.Text}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="8,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="逾期" FontSize="11"
                                                           Foreground="{DynamicResource Brush.Overdue}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Overdue}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <CheckBox Grid.Column="3" Style="{StaticResource RowCheck}"
                                                          IsChecked="{Binding Completed, Mode=OneWay}"
                                                          Checked="RowComplete_Checked" VerticalAlignment="Center"/>
                                                <Grid.InputBindings>
                                                    <MouseBinding Gesture="LeftDoubleClick"
                                                                  Command="{Binding DataContext.EditRowCommand, ElementName=TodoList}"/>
                                                </Grid.InputBindings>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid x:Name="TodoEmpty" Visibility="Hidden" Height="34">
                                <TextBlock Text="今天还没有待办" FontSize="11"
                                           Foreground="{DynamicResource Brush.Faint}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Height="34" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="已完成 · " FontSize="10"
                                               Foreground="{DynamicResource Brush.Faint}"/>
                                    <TextBlock x:Name="DoneCount" Text="0" FontSize="10"
                                               Foreground="{DynamicResource Brush.Faint}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Height="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.Hairline}"/>
                                <Button Grid.Column="2" Width="16" Height="16" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="按完成时间排序"
                                        Click="DoneSort_Click">
                                    <Viewbox Width="12" Height="12">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource Icon.SortAsc}"
                                                  Stroke="{DynamicResource Brush.Faint}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="DoneList" ItemsSource="{Binding DoneRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding CompletedTimeText}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.DoneStamp}"
                                                       TextAlignment="Right" Padding="0,0,8,0"
                                                       VerticalAlignment="Center"/>
                                            <Grid Grid.Column="1">
                                                <Border Width="2" HorizontalAlignment="Center"
                                                        Background="{DynamicResource Brush.CardBorder}"
                                                        Opacity="0.55"/>
                                                <Ellipse Width="7" Height="7"
                                                         Fill="{DynamicResource Brush.Accent}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Column="2" Text="{Binding Content}"
                                                       FontSize="13" Foreground="{DynamicResource Brush.Muted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="8,0,8,0"/>
                                            <CheckBox Grid.Column="3" Style="{StaticResource RowCheck}"
                                                      IsChecked="True" IsEnabled="False"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="ScaleGrip" Width="24" Height="24"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  RenderTransformOrigin="1,1" Cursor="SizeNWSE" Background="Transparent">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="GripScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Border Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,3,3" Opacity="0.7"
                        BorderBrush="{DynamicResource Brush.Muted}" BorderThickness="0,0,2,2"
                        CornerRadius="0,0,9,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
