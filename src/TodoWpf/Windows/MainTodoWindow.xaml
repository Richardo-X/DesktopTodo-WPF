<Window x:Class="TodoWpf.Windows.MainTodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面待办"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource Brush.Shell}"
        ResizeMode="CanResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Ib" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <!-- 按压体感（原型 .ib:active）：0.96 缩放缓出 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- 禁用（批量态冻结设置入口，原型 .frozen-btn：.45 置灰） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sq" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource Anim.PressIn}"/>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard Storyboard="{StaticResource Anim.PressOut}"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 批量条按钮（原型 .sbtn：28 高 / 字 11 / r6 / 静默灰字，悬停行底色+正文字；禁用 .45） -->
        <Style x:Key="BatchSbtn" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 批量条危险按钮（原型 .sbtn.danger：红字红边） -->
        <Style x:Key="BatchSbtnDanger" TargetType="Button" BasedOn="{StaticResource BatchSbtn}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Overdue}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OverdueEdge}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Overdue}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowCard" TargetType="Border">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2"/>
            <!-- 行内边距：WPF 写法是「左右,上下」——ele 为 padding:11px 12px（上下 11 / 左右 12）。
                 此前写成 11,12（左右 11 / 上下 12）→ 行内可用高 = 44-24-2 = 18 < 勾选框 20 → 勾选框被挤溢出。 -->
            <Setter Property="Padding" Value="12,11"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Brush.RowCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.RowCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <!-- 行卡悬停（原型 .trow[data-kind=p]:hover：底 row-hover + 描边 accent） -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </Trigger>
                <!-- 批量选中（原型 .picked：accent-soft 底 + accent 描边；悬停底让位给选中底） -->
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.SoftAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd" Width="20" Height="20" CornerRadius="6"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                Background="Transparent">
                            <Viewbox x:Name="ck" Width="12" Height="12" Visibility="Collapsed">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Check}"
                                          Stroke="{DynamicResource Brush.AccentFg}" StrokeThickness="2.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="ck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CardRoot" Background="{DynamicResource Brush.Shell}">
        <Grid>
            <Grid x:Name="CardContent" Width="360" Height="640"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" Margin="16,12,16,4" MouseLeftButtonDown="Titlebar_MouseDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="5"
                                Background="{DynamicResource Brush.Accent}">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.AccentFg}"
                                          StrokeThickness="2.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="桌面待办" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="ThemeBtn" Style="{StaticResource Ib}" ToolTip="切换日/夜主题" Click="ThemeBtn_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Moon}" Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="PinBtn" Style="{StaticResource Ib}" ToolTip="窗口置顶开关" Click="PinBtn_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="PinIcon" Data="{StaticResource Icon.Pin}"
                                          Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="TuckLockBtn" Style="{StaticResource Ib}" ToolTip="缩进锁定" Click="TuckLockBtn_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.TuckLock}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="SettingsBtn" Style="{StaticResource Ib}" ToolTip="设置" Click="SettingsBtn_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.Gear}" Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <Button x:Name="HideBtn" Style="{StaticResource Ib}" ToolTip="最小化到系统状态栏" Click="HideBtn_Click">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.X}" Stroke="{DynamicResource Brush.Faint}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,10">
                        <TextBlock x:Name="ClockTime" Text="14:32" FontSize="38" FontWeight="Medium"
                                   FontFamily="{StaticResource Font.Display}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   Typography.NumeralAlignment="Tabular"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ClockDate" Text="2026年10月12日 星期一" FontSize="15"
                                   Foreground="{DynamicResource Brush.Faint}" Margin="0,2,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid x:Name="ActionBar" Grid.Row="1" Margin="14,2,14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 圆角显式 = 高度 24 的一半：WPF 对超大 CornerRadius 会 X/Y 独立截断成椭圆角，
                                 与浏览器按比例缩放的胶囊不同（原型 border-radius:99px 实际得到半径 12 的圆角） -->
                            <Border Background="{DynamicResource Brush.CounterChip}" CornerRadius="13"
                                    Height="26" Padding="10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="CountText" Text="0/10" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Muted}"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Button x:Name="BatchToggleBtn" Style="{StaticResource Sq}" Margin="8,0,0,0" ToolTip="批量删除待办"
                                    Click="BatchToggle_Click">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.Muted}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="AddBtn" Background="{DynamicResource Brush.Accent}" BorderThickness="0"
                                    Width="32" Height="32" Cursor="Hand" ToolTip="新建待办" Click="AddBtn_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource Brush.AccentFg}"
                                                          StrokeThickness="2.2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="QuickBtn" Style="{StaticResource Sq}" Margin="8,0,0,0"
                                    ToolTip="显示 / 隐藏模板窗" Click="QuickBtn_Click">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource Icon.Bolt}"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 批量条（原型 #batchbar）：与动作行同位等高替换；
                         布局 = 已选 n 项 · 返回 …… 全选 · 删除所选（弹性空白居中隔开） -->
                    <Grid x:Name="BatchBar" Grid.Row="1" Visibility="Hidden" Margin="14,2,14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="BatchCount" Text="已选 0 项" FontSize="11" LineHeight="18"
                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular"/>
                            <Button x:Name="BatchExitBtn" Content="返回" Style="{StaticResource BatchSbtn}"
                                    Margin="8,0,0,0" Click="BatchExit_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BatchAllBtn" Content="全选" Style="{StaticResource BatchSbtn}"
                                    Click="BatchAll_Click"/>
                            <Button x:Name="BatchDeleteBtn" Content="删除所选" Style="{StaticResource BatchSbtnDanger}"
                                    Margin="8,0,0,0" IsEnabled="False" Click="BatchDelete_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 底部 24 让位缩放角标：用 Margin 而非 Padding——Padding 不缩小滚动条，
                         滚动条会一直画到窗口底、穿过角标（用户 2026-11-04 反馈）；
                         Margin 收窄容器 → 滚动条命中下限 = 列表内容下限 -->
                    <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="14,0,9,0" Margin="0,0,0,24"
                                  ScrollChanged="ListScroll_ScrollChanged">
                        <StackPanel>
                            <ItemsControl x:Name="TodoList" ItemsSource="{Binding Rows}"
                              AutomationProperties.AutomationId="TodoList">
                                <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RowCard}" MouseLeftButtonDown="Row_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 拖拽把手：透明命中区占满整列（原型 .grip 命中含 ±3px 延展），
                                                 点阵居中于"卡片左缘↔文字左缘"之间（用户 2026-11-03 裁定）；
                                                 此前命中=图标 6 个小点（每点约 2px）导致几乎点不中。 -->
                                            <Border Grid.Column="0" Width="32" Margin="-12,0,0,0"
                                                    Background="Transparent" Cursor="Hand"
                                                    MouseLeftButtonDown="Grip_MouseDown"
                                                    HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <!-- 批量中点阵禁用（原型 .grip.disabled） -->
                                                            <DataTrigger Binding="{Binding BatchMode}" Value="True">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                                <Setter Property="Cursor" Value="No"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Viewbox Width="14" Height="14">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="{StaticResource Icon.Grip}"
                                                              Fill="{DynamicResource Brush.Faint}"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Content}"
                                                       FontSize="16.5" TextTrimming="CharacterEllipsis"
                                                       LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                                       VerticalAlignment="Center" Margin="6,0,2,0"
                                                       MouseEnter="RowText_MouseEnter" MouseLeave="RowText_MouseLeave">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                                        <Style.Triggers>
                                                            <!-- 批量选中：正文变次级色（原型 .picked .tx） -->
                                                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="逾期" FontSize="10"
                                                       Foreground="{DynamicResource Brush.Overdue}"
                                                       VerticalAlignment="Center" Margin="0,0,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Overdue}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <CheckBox Grid.Column="3" VerticalAlignment="Center"
                                                      Click="RowCheck_Click">
                                                <!-- 批量态：同一颗行尾勾选框变"选中"指示（原型 .cb.selecting）。
                                                     仅指示不可点（用户 2026-11-04 裁定：整行点击切换）——
                                                     注意绑定设值同样会触发 Checked 事件，代码侧须以 InBatch 屏蔽。 -->
                                                <CheckBox.Style>
                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource RowCheck}">
                                                        <Setter Property="IsChecked" Value="{Binding Completed, Mode=OneWay}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BatchMode}" Value="True">
                                                                <Setter Property="IsChecked" Value="{Binding Selected, Mode=OneWay}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </CheckBox.Style>
                                            </CheckBox>
                                            <Grid.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.EditRowCommand, ElementName=TodoList}"
                                                              CommandParameter="{Binding}"/>
                                            </Grid.InputBindings>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 单行行内空态（原型 .empty.inline：高 36，落在最后一条待办的位置；
                                 批量态换文案，由 SetBatchBar 推送） -->
                            <StackPanel x:Name="TodoEmpty" Orientation="Horizontal" Height="46"
                                        HorizontalAlignment="Center" Visibility="Hidden">
                                <TextBlock x:Name="TodoEmptyA" Text="今天还没有待办" FontSize="13"
                                           Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TodoEmptyB" Text="点 ＋ 新建一条" FontSize="11"
                                           Foreground="{DynamicResource Brush.Faint}" Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 已完成段（时间轴 + 行）：批量态整段变暗禁点（原型 .dimdone） -->
                            <StackPanel x:Name="DoneBlock">
                                <Grid Height="40" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="已完成 · " FontSize="12"
                                                   Foreground="{DynamicResource Brush.Faint}"/>
                                        <TextBlock x:Name="DoneCount" Text="0" FontSize="12"
                                                   Foreground="{DynamicResource Brush.Faint}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.Hairline}"/>
                                    <Button Grid.Column="2" Width="24" Height="24" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand" ToolTip="按完成时间排序"
                                            Click="DoneSort_Click">
                                        <Viewbox Width="15" Height="15">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{StaticResource Icon.SortAsc}"
                                                      Stroke="{DynamicResource Brush.Faint}" StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="DoneEmpty" Text="今天还没有完成的事项" FontSize="13"
                                           Foreground="{DynamicResource Brush.Faint}" Margin="0,16,0,4"
                                           HorizontalAlignment="Center" Visibility="Collapsed"/>

                                <Grid>
                                    <!-- 时间轴整段一条线：与行内节点共用同一套列定义（34/16/*/16），
                                         不用 Margin 硬算，避免与节点错位；上下各缩进半行 17 -->
                                    <Grid IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="1" Width="2" HorizontalAlignment="Center"
                                                Margin="0,22,0,22"
                                                Background="{DynamicResource Brush.CardBorder}" Opacity="0.55"/>
                                    </Grid>
                                    <ItemsControl x:Name="DoneList" ItemsSource="{Binding DoneRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="44">
                                                    <Grid.InputBindings>
                                                        <!-- 双击已完成行 → 只读详情窗（需求 §2.6） -->
                                                        <MouseBinding Gesture="LeftDoubleClick"
                                                                      Command="{Binding DataContext.DoneDetailCommand, ElementName=DoneList}"
                                                                      CommandParameter="{Binding}"/>
                                                    </Grid.InputBindings>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CompletedTimeText}" FontSize="11"
                                                               Foreground="{DynamicResource Brush.DoneStamp}"
                                                               TextAlignment="Right" Padding="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="1">
                                                        <Ellipse Width="7" Height="7"
                                                                 Fill="{DynamicResource Brush.Accent}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding Content}"
                                                               FontSize="16.5" LineHeight="20"
                                                               LineStackingStrategy="BlockLineHeight"
                                                               Foreground="{DynamicResource Brush.Muted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" Margin="8,0,8,0"
                                                               MouseEnter="RowText_MouseEnter" MouseLeave="RowText_MouseLeave"/>
                                                    <CheckBox Grid.Column="3" Style="{StaticResource RowCheck}"
                                                              IsChecked="True" IsEnabled="False"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- toast（原型 .toasts：fixed 定位、不随主窗缩放；底部居中深色胶囊，
                 2.2s 自动消失；纯展示层不接鼠标） -->
            <Border x:Name="ToastPill" Panel.ZIndex="30"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,28" IsHitTestVisible="False" Visibility="Collapsed"
                    Background="{DynamicResource Brush.Toast}" CornerRadius="8" Padding="14,9">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastShift" Y="0"/>
                </Border.RenderTransform>
                <TextBlock x:Name="ToastText" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource Brush.ToastFg}"/>
            </Border>

            <Grid x:Name="ScaleGrip" Width="24" Height="24"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  RenderTransformOrigin="1,1" Cursor="SizeNWSE" Background="Transparent">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="GripScale" ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>
                <Border Width="13" Height="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,3,3" Opacity="0.7"
                        BorderBrush="{DynamicResource Brush.Muted}" BorderThickness="0,0,2,2"
                        CornerRadius="0,0,9,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
