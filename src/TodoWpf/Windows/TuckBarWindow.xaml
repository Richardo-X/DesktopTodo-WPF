<Window x:Class="TodoWpf.Windows.TuckBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面待办 · 白条"
        Width="160" Height="12"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Text}">

    <!-- 缩进白条（R1：独立轻量元素，不再是"应用折叠成的一条"）。
         鼠标碰到白条本体（系统真实命中，被遮挡天然不弹）→ 整组滑回；点击亦可。 -->

    <Border x:Name="Bar" Background="{DynamicResource Brush.TuckBar}" CornerRadius="6">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Brush.TuckBarHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    </Border>
</Window>
