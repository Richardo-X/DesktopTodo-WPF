<Window x:Class="TodoWpf.Windows.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷添加"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <!-- 快捷添加（模板库）壳：假数据；业务批次 04 接线 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource GridLength.Titlebar}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_MouseDown">
            <TextBlock Text="快捷添加" FontSize="{StaticResource Size.BodyFont}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="模板 · 3/10" FontSize="{StaticResource Size.BodyFont}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SmallButton}" Tag="{StaticResource Icon.Trash}"
                            Content="批量删除" ToolTip="批量删除（批次 04 实装）" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource AddButton}" Tag="{StaticResource Icon.Plus}"
                            ToolTip="新建模板（批次 04 实装）"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1">
                <Border Style="{StaticResource TodoRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource Icon.Grip}" Fill="{DynamicResource Brush.Faint}"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="每天站会前喝口水"
                                   FontSize="{StaticResource Size.BodyFont}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource PlusBox}"
                                ToolTip="加入今日待办（批次 04 实装）" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource TodoRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource Icon.Grip}" Fill="{DynamicResource Brush.Faint}"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="写周报并发给部门同步"
                                   FontSize="{StaticResource Size.BodyFont}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource PlusBox}"
                                ToolTip="加入今日待办（批次 04 实装）" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource TodoRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource Icon.Grip}" Fill="{DynamicResource Brush.Faint}"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="整理桌面文件归档"
                                   FontSize="{StaticResource Size.BodyFont}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource PlusBox}"
                                ToolTip="加入今日待办（批次 04 实装）" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource Brush.Hover}"
                    CornerRadius="{StaticResource Radius.Control}" Padding="10,7">
                <TextBlock Text="模板不计入待办数量上限；点击条目右侧 ＋ 可加入今日待办，模板不会消失。"
                           FontSize="{StaticResource Size.MicroFont}" LineHeight="17"
                           Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</Window>
