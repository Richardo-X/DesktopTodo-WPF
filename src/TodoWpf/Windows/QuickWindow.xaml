<Window x:Class="TodoWpf.Windows.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷添加"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <!-- 快捷添加（模板库）壳：假数据；业务批次 04 接线 -->

    <!-- 卡面：固定设计尺寸 310×640（含底色+描边+内容整体），
         缩放走**渲染层** RenderTransform，锚点＝右上角（1,0）——本窗钉住角。
         为什么不用 LayoutTransform / 改 Width：那要走布局（测量+排列整棵子树）才会生效，
         比主窗"窗口矩形变化（系统层即时）"慢半拍，观感就是"快捷窗缩放跟不上主窗"（用户 2026-10-13）。
         渲染层变换不触发布局，和主窗的矩形变化同帧生效。
         窗口矩形本身恒为"画布"（缩放上限尺寸，见 ClusterController.QuickCanvasRect），永不改变，
         所以既无拖影、也无按下/松手闪动。 -->
    <Border x:Name="CardRoot" Width="310" Height="640"
            Background="{DynamicResource Brush.WinBg}"
            BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
            HorizontalAlignment="Right" VerticalAlignment="Top"
            RenderTransformOrigin="1,0"
            CornerRadius="{StaticResource Radius.Panel}">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid x:Name="CardContent" Width="310" Height="640">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource GridLength.Titlebar}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_MouseDown">
            <TextBlock Text="快捷添加" FontSize="{StaticResource Size.PanelTitleFont}"
                       FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部三列：模板计数（占剩余）｜批量删除（固定）｜＋（固定）。 -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TemplateCount" Text="模板 · 3/10" FontSize="{StaticResource Size.PanelTitleFont}"
                           FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Tag="{StaticResource Icon.Trash}"
                        Content="批量删除" ToolTip="批量删除（批次 04 实装）" Margin="0,0,6,0"
                        Width="92" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Style="{StaticResource AddButton}" Tag="{StaticResource Icon.Plus}"
                        ToolTip="新建模板" Click="AddTemplate_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- 真实模板列表（绑定 TemplateRows）；行间距 6（原型快捷窗列表口径） -->
            <ItemsControl x:Name="TemplateList" Grid.Row="1" ItemsSource="{Binding TemplateRows}"
                          AlternationCount="1000">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TodoRow}" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource Icon.Grip}" Fill="{DynamicResource Brush.Faint}"
                                      Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Content}"
                                           FontSize="{StaticResource Size.RowFont}"
                                           Foreground="{DynamicResource Brush.Text}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="8,0,10,0">
                                    <TextBlock.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.EditTemplateCommand, ElementName=TemplateList}"/>
                                    </TextBlock.InputBindings>
                                </TextBlock>
                                <Button Grid.Column="2" Style="{StaticResource PlusBox}"
                                        ToolTip="加入今日待办" Click="ApplyTemplate_Click" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="2" Background="{DynamicResource Brush.Hover}"
                    CornerRadius="{StaticResource Radius.Control}" Padding="10,7">
                <TextBlock Text="模板不计入待办数量上限；点击条目右侧 ＋ 可加入今日待办，模板不会消失。"
                           FontSize="{StaticResource Size.MicroFont}" LineHeight="17"
                           Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"/>
            </Border>
        </Grid>
        </Grid>
    </Border>

</Window>
