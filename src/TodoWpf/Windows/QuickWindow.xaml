<Window x:Class="TodoWpf.Windows.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模板"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource Brush.Shell}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <Window.Resources>
        <Style x:Key="Sq" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CardRoot" Background="{DynamicResource Brush.Shell}">
        <Grid>
            <Grid x:Name="CardContent" Width="260" Height="640"
                  HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_MouseDown">
                    <TextBlock Text="模板" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1" Margin="14,0,14,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource Brush.CounterChip}" CornerRadius="99" Padding="9,3">
                            <TextBlock x:Name="TemplateCount" Text="0/10" FontSize="11"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       Typography.NumeralAlignment="Tabular"/>
                        </Border>
                        <Button Style="{StaticResource Sq}" Margin="8,0,0,0" ToolTip="新建模板"
                                Click="AddTemplate_Click">
                            <Path Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource Brush.Muted}"
                                  StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="8,4,2,8">
                        <ItemsControl x:Name="TemplateList" ItemsSource="{Binding TemplateRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="36">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="22"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Content}" FontSize="13"
                                                   Foreground="{DynamicResource Brush.Text}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="6,0,8,0"/>
                                        <Button Grid.Column="1" Width="22" Height="22"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" ToolTip="加入今日待办"
                                                Click="ApplyTemplate_Click">
                                            <Path Data="{StaticResource Icon.Plus}"
                                                  Stroke="{DynamicResource Brush.Faint}"
                                                  StrokeThickness="2" Width="11" Height="11" Stretch="Uniform"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Button>
                                        <Grid.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick"
                                                          Command="{Binding DataContext.EditTemplateCommand, ElementName=TemplateList}"/>
                                        </Grid.InputBindings>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="TemplateEmpty" Text="还没有模板" FontSize="11"
                               Foreground="{DynamicResource Brush.Faint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
