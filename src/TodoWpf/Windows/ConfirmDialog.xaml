<Window x:Class="TodoWpf.Windows.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" Background="{DynamicResource Brush.Shell}"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <Window.Resources>
        <!-- 原型 .btn：32 高、r6、字 12 -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimarySmBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.AccentFg}"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险确认（原型 .btn.danger：红字红边透明底，悬停浅红底） -->
        <Style x:Key="DangerSmBtn" TargetType="Button" BasedOn="{StaticResource PrimarySmBtn}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Overdue}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.OverdueEdge}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SoftOverdue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 确认框（原型 .cbox，D 类）：340 × 内容高、Shell 底、r10、蓝黑投影；
         定位 = 居中于「打开它的窗口」（Confirm 传入锚窗），越界钳回所在屏工作区。 -->
    <Border Background="{DynamicResource Brush.Shell}"
            BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Dialog}">
        <!-- 内容自己带 20 内边距；X 放在 Grid 里贴右上角（距上/右各 8），
             不再受内边距挤在内容区里（用户 2026-11-06：把 X 移到右上角） -->
        <Grid>
            <Button x:Name="CloseBtn" Width="24" Height="24" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,8,8,0" Visibility="Collapsed"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    ToolTip="关闭" Click="Close_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <!-- 图标 16（用户 2026-11-06）：与主窗标题栏 X 同规格 -->
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Icon.X}"
                                          Stroke="{DynamicResource Brush.Muted}" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        <StackPanel Margin="20">
            <!-- 标题（右侧留 28 给右上角 X，避免长标题压到它） -->
            <TextBlock x:Name="TitleText" Text="确认" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" Margin="0,0,28,0"/>
            <TextBlock x:Name="BodyText" Text="" FontSize="12" LineHeight="20"
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
            <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource GhostBtn}"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="OkBtn" Content="确定" Style="{StaticResource PrimarySmBtn}"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
