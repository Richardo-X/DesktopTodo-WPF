<Window x:Class="TodoWpf.Windows.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="悬停气泡"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Topmost="True" IsHitTestVisible="False"
        Focusable="False">

    <!-- 悬停气泡（原型 .bubble，规格-窗口尺寸与缩放 §D 的透明窗例外）：
         宽 280、padding 9/12、圆角 8、箭头 6×12 指向行；整体随所属窗缩放（LayoutTransform）。
         「透明常驻」：窗口始终 Visible、空闲时 Opacity=0——避免显示时表面重建的闪现
         （Electron 版踩坑：气泡以全尺寸显示再收缩=尺寸跳变闪现）。 -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColArrowLeft" Width="0"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="ColArrowRight" Width="6"/>
        </Grid.ColumnDefinitions>

        <!-- 气泡在行右侧：箭头在左缘、指向左 -->
        <Polygon x:Name="ArrowLeft" Grid.Column="0" Width="6" Height="12"
                 Points="6,0 0,6 6,12" Fill="{DynamicResource Brush.BubbleBg}"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Border Grid.Column="1" Width="280" Padding="12,9" CornerRadius="8"
                Background="{DynamicResource Brush.BubbleBg}"
                BorderBrush="{DynamicResource Brush.BubbleBorder}" BorderThickness="1">
            <TextBlock x:Name="BubbleText" FontSize="12" LineHeight="18"
                       Foreground="{DynamicResource Brush.BubbleFg}"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- 气泡在行左侧：箭头在右缘、指向右 -->
        <Polygon x:Name="ArrowRight" Grid.Column="2" Width="6" Height="12"
                 Points="0,0 6,6 0,12" Fill="{DynamicResource Brush.BubbleBg}"
                 HorizontalAlignment="Left" VerticalAlignment="Top"/>
    </Grid>
</Window>
