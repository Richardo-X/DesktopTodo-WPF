<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 应用图标（快捷方式/资源管理器/应用和功能/更新包都取它）：
         与应用标题栏品牌标记同一套视觉，由 docs/tools/make-icon.py 生成 -->
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <!-- 应用版本：设置页「当前版本」与更新检查的基准；发布时由发布脚本 -p:Version 覆盖 -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TodoWpf.Core\TodoWpf.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms（托盘）与 WPF 混用时的类型歧义消解 -->
    <Using Include="Application = System.Windows.Application" />
    <Using Include="Point = System.Windows.Point" />
    <Using Include="MouseEventArgs = System.Windows.Input.MouseEventArgs" />
    <Using Include="Button = System.Windows.Controls.Button" />
    <Using Include="Brush = System.Windows.Media.Brush" />
    <Using Include="Panel = System.Windows.Controls.Panel" />
    <Using Include="VisualTreeHelper = System.Windows.Media.VisualTreeHelper" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
