<Window x:Class="TodoWpf.Preview.MainPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TodoWpf"
        Title="外观预览 · 待办主窗（静态）"
        Width="600"
        Height="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        UseLayoutRounding="True" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource Font.Text}">

    <!-- 预览工具：产品观感来自令牌；本窗仅为外观验收载体（月亮=切主题、规格检查=切陈列，其余不可点） -->

    <Border Background="{DynamicResource Brush.WinBg}"
            BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="1"
            CornerRadius="{StaticResource Radius.Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{StaticResource GridLength.Titlebar}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ============ 标题栏 ============ -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Titlebar_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="17" Height="17" CornerRadius="{StaticResource Radius.Control}"
                            Background="{DynamicResource Brush.Accent}">
                        <Path Data="{StaticResource Icon.Check}"
                              Stroke="{DynamicResource Brush.AccentFg}" StrokeThickness="3.4"
                              Width="10" Height="10" Stretch="Uniform"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Border>
                    <TextBlock Text="{x:Static app:AppInfo.DisplayName}" FontSize="{StaticResource Size.BodyFont}"
                               FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                               Margin="7,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button x:Name="ThemeBtn" Style="{StaticResource TitlebarButton}"
                            Tag="{StaticResource Icon.Moon}" ToolTip="切换日/夜主题（预览工具功能）"
                            Click="ThemeBtn_Click"/>
                    <Button Style="{StaticResource TitlebarButton}" Tag="{StaticResource Icon.Pin}"
                            ToolTip="窗口置顶开关（批次 03 实装）"/>
                    <Button Style="{StaticResource TitlebarButton}" Tag="{StaticResource Icon.TuckLock}"
                            ToolTip="缩进锁定（批次 03 实装）"/>
                    <Button Style="{StaticResource TitlebarButton}" Tag="{StaticResource Icon.Gear}"
                            ToolTip="设置（批次 04 实装）"/>
                    <Button Style="{StaticResource TitlebarCloseButton}" Tag="{StaticResource Icon.X}"
                            ToolTip="缩小到通知栏（批次 03 实装；预览中=关闭预览）" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- ============ 主体 ============ -->
            <Grid Grid.Row="1" Margin="14,10,14,8">

                <!-- 视图 A：待办主窗静态外观（假数据） -->
                <Grid x:Name="MainView" Width="470" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 时钟（Display 字体 + 等宽数字；L1 第 5 项） -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock x:Name="ClockTime" Text="14:32" FontSize="{StaticResource Size.ClockTimeFont}"
                                   FontWeight="SemiBold" FontFamily="{StaticResource Font.Display}"
                                   Foreground="{DynamicResource Brush.Text}"
                                   Typography.NumeralAlignment="Tabular" LineHeight="33"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ClockDate" Text="2026年10月12日 星期一"
                                   FontSize="{StaticResource Size.ClockDateFont}"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,2,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 操作区：⚡/☑ + 计数/批量删除 + ＋（左右端与列表行同边，L1 第 11 项） -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Bolt}"
                                    ToolTip="快捷添加开关（批次 03/04 实装）" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource Icon.PanelCheck}"
                                    ToolTip="已完成开关（批次 03/04 实装）"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="3/10" FontSize="{StaticResource Size.BodyFont}"
                                       Foreground="{DynamicResource Brush.Muted}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SmallButton}" Tag="{StaticResource Icon.Trash}"
                                    Content="批量删除" ToolTip="批量删除（批次 04 实装）"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource AddButton}"
                                Tag="{StaticResource Icon.Plus}" ToolTip="新建待办（批次 04 实装）"/>
                    </Grid>

                    <!-- 列表（假数据；悬停演示 L1 行过渡） -->
                    <ItemsControl Grid.Row="2">
                        <ItemsControl.Items>
                            <Border Style="{StaticResource TodoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Grip}"
                                          Fill="{DynamicResource Brush.Faint}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="写周报并发给部门同步"
                                               FontSize="{StaticResource Size.BodyFont}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="逾期"
                                               FontSize="{StaticResource Size.MicroFont}"
                                               Foreground="{DynamicResource Brush.Overdue}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Checkbox}" IsChecked="False"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TodoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Grip}"
                                          Fill="{DynamicResource Brush.Faint}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="整理下季度 OKR 草稿，把三条主线目标拆成可执行的关键结果再提交评审"
                                               FontSize="{StaticResource Size.BodyFont}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Checkbox}" IsChecked="False"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TodoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Grip}"
                                          Fill="{DynamicResource Brush.Faint}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="买牛奶、鸡蛋和全麦面包"
                                               FontSize="{StaticResource Size.BodyFont}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Checkbox}" IsChecked="False"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TodoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Grip}"
                                          Fill="{DynamicResource Brush.Faint}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="每天站会前喝口水"
                                               FontSize="{StaticResource Size.BodyFont}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Checkbox}" IsChecked="False"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TodoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Grip}"
                                          Fill="{DynamicResource Brush.Faint}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="给交好的同事补上周五落下的会议纪要，重点标出设备采购的三条结论"
                                               FontSize="{StaticResource Size.BodyFont}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Checkbox}" IsChecked="False"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource TodoRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Grip}"
                                          Fill="{DynamicResource Brush.Faint}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="预约牙医复诊"
                                               FontSize="{StaticResource Size.BodyFont}"
                                               Foreground="{DynamicResource Brush.Text}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <CheckBox Grid.Column="3" Style="{StaticResource Checkbox}" IsChecked="False"
                                              IsHitTestVisible="False" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </ItemsControl.Items>
                    </ItemsControl>
                </Grid>

                <!-- 视图 B：规格检查（陈列层；预览工具，非产品界面） -->
                <ScrollViewer x:Name="SpecView" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2,0,2,64">

                        <TextBlock Text="规格检查 · 预览工具（非产品界面）"
                                   FontSize="{StaticResource Size.BodyFont}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="基准：docs/参考/交互原型-v3.4-taste.html ＋ v1.1.1 L1 体验说明书"
                                   FontSize="{StaticResource Size.MicroFont}"
                                   Foreground="{DynamicResource Brush.Faint}" Margin="0,2,0,12"/>

                        <!-- 文字三阶 -->
                        <TextBlock Text="文字三阶" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="主文本 #1A1C20 / 夜 #F2F3F5" FontSize="{StaticResource Size.BodyFont}"
                                   Foreground="{DynamicResource Brush.Text}"/>
                        <TextBlock Text="副文本 #5D616B / 夜 #ABAFB8" FontSize="{StaticResource Size.BodyFont}"
                                   Foreground="{DynamicResource Brush.Muted}"/>
                        <TextBlock Text="淡文本 #8B8F99 / 夜 #7D818C" FontSize="{StaticResource Size.BodyFont}"
                                   Foreground="{DynamicResource Brush.Faint}" Margin="0,0,0,12"/>

                        <!-- 关键色 -->
                        <TextBlock Text="关键色（随日/夜切换实时变化）" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,0,0,6"/>
                        <StackPanel x:Name="SwatchPanel" Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="34" Height="14" CornerRadius="{StaticResource Radius.Grip}"
                                        Background="{DynamicResource Brush.Accent}"/>
                                <TextBlock Text="主题色 Accent" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="34" Height="14" CornerRadius="{StaticResource Radius.Grip}"
                                        Background="{DynamicResource Brush.Hover}"/>
                                <TextBlock Text="悬停 Hover（α5%/夜6%）" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="34" Height="14" CornerRadius="{StaticResource Radius.Grip}"
                                        Background="{DynamicResource Brush.Btn}" BorderBrush="{DynamicResource Brush.BtnBorder}"/>
                                <TextBlock Text="按钮面 Btn（α75%/夜8%）＋边框" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="34" Height="14" CornerRadius="{StaticResource Radius.Grip}"
                                        Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}"/>
                                <TextBlock Text="卡面 Card（α70%/夜5.5%）＋边框" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="34" Height="14" CornerRadius="{StaticResource Radius.Grip}"
                                        Background="{DynamicResource Brush.Danger}"/>
                                <TextBlock Text="危险 #C42B1C（日夜同值）" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="34" Height="14" CornerRadius="{StaticResource Radius.Grip}"
                                        Background="{DynamicResource Brush.Overdue}"/>
                                <TextBlock Text="逾期红 #D13438（日夜同值）" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="34" Height="14" CornerRadius="{StaticResource Radius.Grip}"
                                        Background="{DynamicResource Brush.Mask}"/>
                                <TextBlock Text="蒙层 rgba(10,20,40,.46)（蓝黑色调）" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 圆角阶梯 -->
                        <TextBlock Text="圆角阶梯（6 控件 / 8 行 / 10 对话框与面板）" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Control}"
                                    Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"/>
                            <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Row}"
                                    Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" Margin="8,0,0,0"/>
                            <Border Width="36" Height="36" CornerRadius="{StaticResource Radius.Dialog}"
                                    Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1" Margin="8,0,0,0"/>
                            <TextBlock Text="6 / 8 / 10" FontSize="{StaticResource Size.MicroFont}"
                                       Foreground="{DynamicResource Brush.Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <!-- 按钮阶梯 -->
                        <TextBlock Text="按钮规格阶梯（32 / 30 / 26 / 28 / 20）" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,4">
                            <StackPanel Margin="0,0,14,8">
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource Icon.Bolt}" IsEnabled="True"/>
                                <TextBlock Text="图标 32" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <Button Style="{StaticResource SmallButton}" Tag="{StaticResource Icon.Trash}" Content="批量删除"/>
                                <TextBlock Text="小按钮 26" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="主按钮"/>
                                <TextBlock Text="主按钮 30" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <Button Style="{StaticResource DangerButton}" Content="删除"/>
                                <TextBlock Text="危险 30" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <Button Style="{StaticResource StepperButton}" Content="−"/>
                                <TextBlock Text="步进器 28" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,14,8">
                                <CheckBox Style="{StaticResource Checkbox}" IsChecked="True" IsHitTestVisible="False"/>
                                <TextBlock Text="勾选框 20" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <Button Style="{StaticResource PlusBox}"/>
                                <TextBlock Text="＋框 20" FontSize="{StaticResource Size.MicroFont}"
                                           Foreground="{DynamicResource Brush.Faint}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- 图标集 -->
                        <TextBlock Text="线性图标集（原型 I.* 同源，单族）" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Check}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="3"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="check" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Plus}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="2"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round"/>
                                <TextBlock Text="plus" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.ChevL}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="2"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="chevL" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.X}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round"/>
                                <TextBlock Text="x" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Clock}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round"/>
                                <TextBlock Text="clock" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Trash}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="trash" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Undo}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="undo" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Bolt}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="bolt" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.PanelCheck}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="panelCheck" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Gear}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="gear" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Moon}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="moon" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Sun}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round"/>
                                <TextBlock Text="sun" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Pin}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="pin" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.TuckLock}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.7"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="tuckLock" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.SortAsc}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="sortAsc" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.SortDesc}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="1.8"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="sortDesc" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <Path Data="{StaticResource Icon.Grip}" Fill="{DynamicResource Brush.Text}"
                                      Width="16" Height="16" Stretch="Uniform"/>
                                <TextBlock Text="grip" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <Path Data="{StaticResource Icon.ChevR}" Stroke="{DynamicResource Brush.Text}" StrokeThickness="2"
                                      Width="16" Height="16" Stretch="Uniform" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                <TextBlock Text="chevR" FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Faint}"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- 对话框样张（验收反馈：加投影三档对比） -->
                        <TextBlock Text="确认框规格（宽 420 / 圆角 10 / 投影对比）" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="投影不是边框描边：是元素轮廓在背景上投出的柔和影子（DropShadowEffect）。默认 = 单层蓝黑（2026-10-12 验收裁定：双层偏深，先用单层；双层保留为备选可切换）；纯黑对照用来展示为何弃用纯黑（深色下发灰发脏）。"
                                   FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Muted}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="ShadowBoth" Style="{StaticResource SmallButton}"
                                    Content="双层投影（定稿）" Margin="0,0,8,0" Click="ShadowBoth_Click"/>
                            <Button x:Name="ShadowBlue" Style="{StaticResource SmallButton}"
                                    Content="蓝投影" Margin="0,0,8,0" Click="ShadowBlue_Click"/>
                            <Button x:Name="ShadowBlack" Style="{StaticResource SmallButton}"
                                    Content="黑投影" Click="ShadowBlack_Click"/>
                        </StackPanel>
                        <Border x:Name="ShadowLayerOuter" HorizontalAlignment="Left"
                                Padding="6" Margin="0,0,0,56">
                            <Border x:Name="ShadowLayerInner" Width="{StaticResource Size.DialogWidth}"
                                    Background="{DynamicResource Brush.CardSolid}"
                                    BorderBrush="{DynamicResource Brush.CardBorder}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Dialog}"
                                    Padding="20,22" Effect="{StaticResource Effect.DialogShadowMain}">
                                <StackPanel>
                                    <TextBlock Text="确认删除所选待办" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,8"/>
                                    <TextBlock Text="确定删除所选的 1 项吗？删除后无法恢复。"
                                               FontSize="{StaticResource Size.BodyFont}" LineHeight="21"
                                               Foreground="{DynamicResource Brush.Muted}"
                                               TextWrapping="Wrap" Margin="0,0,0,17"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SmallButton}" Content="取消" Width="64" Margin="0,0,9,0"/>
                                        <Button Style="{StaticResource DangerButton}" Content="删除" Width="64"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- 动效与关怀 -->
                        <TextBlock Text="动效与关怀" FontSize="{StaticResource Size.BodyFont}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="统一缓出曲线 cubic-bezier(.22,.61,.36,1)；按压反馈 scale 0.96 / 120ms（本预览可试：按住任一按钮）"
                                   FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Muted}"/>
                        <TextBlock Text="行悬停 150ms、颜色过渡 180ms（本预览悬停为瞬时呈现，过渡动画随批次 03 实装）"
                                   FontSize="{StaticResource Size.MicroFont}" Foreground="{DynamicResource Brush.Muted}"/>
                        <TextBlock x:Name="ReducedMotionText" FontSize="{StaticResource Size.MicroFont}"
                                   Foreground="{DynamicResource Brush.Muted}" Margin="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 底部工具条（预览工具，非产品界面） -->
            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,10,6">
                <Button x:Name="SpecToggle" Style="{StaticResource SmallButton}"
                        Content="规格检查" Click="SpecToggle_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
