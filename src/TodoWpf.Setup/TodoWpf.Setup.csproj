<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TodoWpf.Setup</AssemblyName>
    <RootNamespace>TodoWpf.Setup</RootNamespace>
    <Version>1.0.0</Version>
    <!-- 与应用同一图标（用户双击安装器时看到的就是应用图标） -->
    <ApplicationIcon>..\app.ico</ApplicationIcon>

    <!-- 安装器在应用安装前运行，必须自带运行时：自包含 + 单文件（体积大，用户 2026-11-09 已确认接受） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Velopack 的 Setup.exe 由发布脚本以 -p:SetupPayload=<绝对路径> 传入并内嵌，
         使安装器成为**单文件**交付物；未传入时（开发期）回退为查找同目录下的 Setup。 -->
    <EmbeddedResource Include="$(SetupPayload)" Condition="'$(SetupPayload)' != ''"
                      LogicalName="SetupPayload.exe" />
  </ItemGroup>

</Project>
