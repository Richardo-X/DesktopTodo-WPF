<Window x:Class="TodoWpf.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 桌面待办WPF"
        Width="500" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#FFEEF1F6" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI">
    <!-- 安装器（C4 交付形态）：观感对齐应用日间主题（Shell #FFEEF1F6 / Text #33383F / Accent #4F7391）。
         圆角由 DWM 提供（见 Chrome.ApplyRoundCorners），本 Border 只画 1px 描边。 -->
    <Window.Resources>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#5C636C"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14000000"/>
                                <Setter Property="Foreground" Value="#33383F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F7FAFC"/>
            <Setter Property="Background" Value="#4F7391"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5F86A5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#33383F"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#33000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1F1E232A" BorderThickness="1" Background="#FFEEF1F6">
        <StackPanel Margin="22,18,22,20">
            <!-- 标题（可拖动窗口） -->
            <TextBlock Text="安装 桌面待办WPF" FontSize="14" FontWeight="SemiBold"
                       Foreground="#33383F" MouseLeftButtonDown="Title_Drag"/>

            <TextBlock Text="安装位置" FontSize="12" Foreground="#5C636C" Margin="0,16,0,0"/>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Style="{StaticResource Field}"/>
                <Button x:Name="BrowseBtn" Content="浏览…" Style="{StaticResource Ghost}"
                        Grid.Column="1" Margin="6,0,0,0" Click="Browse_Click"/>
            </Grid>

            <TextBlock x:Name="HintText"
                       Text="安装到用户目录无需管理员权限；也可选择其他位置（安装到 Program Files 需要管理员权限）。"
                       FontSize="11" Foreground="#676D76" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#4F7391"
                       Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource Ghost}"
                        Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="InstallBtn" Content="安装" Style="{StaticResource Primary}"
                        Click="Install_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
